# Copy to .env.local (gitignored). Put the same values in every worktree and in Vercel.

# Elasticsearch: Elastic Cloud trial from https://ela.st/hack-kubecon (Elasticsearch project)
ES_URL=
ES_API_KEY=
# Optional: only if setup-es.mjs fails on semantic_text (e.g. start-local without a default model)
ES_INFERENCE_ID=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# A fast, vision-capable model your key can use
CLAUDE_VISION_MODEL=claude-sonnet-5-5
# Can be the same model
CLAUDE_TEXT_MODEL=claude-sonnet-5-5

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 1 = UI uses lib/fixtures.ts instead of the real API (for UI agents before routes merge)
NEXT_PUBLIC_USE_FIXTURES=0
# Where scripts/seed.mjs posts snaps
SEED_URL=http://localhost:3000

# Optional: Dash0 tracing (Agent E). Leave empty and span() stays a no-op.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Authorization=Bearer <dash0 auth token>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=backrow
